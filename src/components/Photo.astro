---
/**
 * A stock photo inside an article. In .mdx: <Photo {...props.photos[0]} />
 * Photos are listed in the article's frontmatter (see scripts/fetch-photos.mjs).
 * Renders nothing if the photo hasn't been downloaded yet.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src?: ImageMetadata;
  alt?: string;
  credit?: string;
  creditUrl?: string;
}
const { src, alt, credit, creditUrl } = Astro.props;
// Pexels supplies a description; fall back to a generic one so every image has alt text.
const altText = alt?.trim() || 'Photo related to this article';
---

{src && (
  <figure class="photo">
    <Image src={src} alt={altText} widths={[480, 800, 1200]} sizes="(max-width: 760px) 100vw, 46rem" loading="lazy" />
    {credit && (
      <figcaption>
        Photo: {creditUrl ? <a href={creditUrl} rel="noopener" target="_blank">{credit}</a> : credit} / Pexels
      </figcaption>
    )}
  </figure>
)}

<style>
  .photo { margin: 2rem 0; }
  .photo :global(img) { width: 100%; height: auto; border-radius: 20px; display: block; }
  figcaption { margin-top: 8px; font-size: 13px; color: var(--ink-2); }
  figcaption a { color: inherit; }
</style>
