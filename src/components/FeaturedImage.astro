---
import type { Article } from '../lib/articles';
import { featuredSvg, specFor } from '../lib/featured';

interface Props {
  article: Article;
  class?: string;
  /** Thumbnails next to a text link are decorative: screen readers already read the title. */
  decorative?: boolean;
}
const { article, class: className, decorative = false } = Astro.props;
const spec = specFor(article);
const label = `Illustration: ${spec.kicker.charAt(0)}${spec.kicker.slice(1).toLowerCase()} ${spec.subject.toLowerCase()}`;
const svg = featuredSvg(spec);
---

{decorative ? (
  <div class:list={['featured', className]} aria-hidden="true" set:html={svg} />
) : (
  <div class:list={['featured', className]} role="img" aria-label={label} set:html={svg} />
)}

<style>
  .featured { line-height: 0; border-radius: 20px; overflow: hidden; }
  .featured :global(svg) { width: 100%; height: auto; display: block; }
</style>
