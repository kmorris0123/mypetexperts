---
interface Props { size?: number; class?: string }
const { size, class: className } = Astro.props;
---

<svg viewBox="0 0 160 130" width={size} class={className} aria-hidden="true" focusable="false"><rect x="14" y="46" width="132" height="60" rx="26" style="fill: #FFCF33" transform="translate(5 5)"></rect><rect x="14" y="46" width="132" height="60" rx="26" style="fill: none; stroke: #1C1A17; stroke-width: 4"></rect><rect x="32" y="62" width="96" height="34" rx="15" style="fill: #FFFFFF; stroke: #1C1A17; stroke-width: 4"></rect></svg>
