import Page from '../layouts/Page.astro';
import { SITE_NAME } from '../consts';
---

<Page title="Affiliate Disclosure" description={`How ${SITE_NAME} makes money and how that affects our recommendations.`}>
  <p>
    {SITE_NAME} is reader-supported. Some links on this site are affiliate links: if you click one and buy something,
    we may earn a commission at no extra cost to you.
  </p>
  <p>
    {SITE_NAME} is a participant in the Amazon Services LLC Associates Program, an affiliate advertising program
    designed to provide a means for sites to earn advertising fees by advertising and linking to Amazon.com. As an
    Amazon Associate we earn from qualifying purchases. We may also take part in affiliate programs run by other
    retailers and brands.
  </p>
  <p>
    Commissions never decide what we recommend or how we rank products. Articles with affiliate links carry a notice
    at the top, and affiliate links are marked as sponsored for search engines.
  </p>
</Page>
