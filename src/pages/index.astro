---
import Base from '../layouts/Base.astro';
import GuideList from '../components/GuideList.astro';
import ProductPick from '../components/ProductPick.astro';
import ProductMini from '../components/ProductMini.astro';
import Dog from '../components/art/Dog.astro';
import Cat from '../components/art/Cat.astro';
import Paw from '../components/art/Paw.astro';
import Arrow from '../components/icons/Arrow.astro';
import { getArticles, getFeaturedProducts } from '../lib/articles';
import { PETS, SITE_NAME, OWNER_NAME, OWNER_PHOTO } from '../consts';

const articles = await getArticles();
const guides = articles.filter((a) => a.data.kind === 'guide');
const featuredGuide = guides.find((a) => a.data.featured && a.data.quickAnswer) ?? guides.find((a) => a.data.quickAnswer);
const otherGuides = guides.filter((a) => a !== featuredGuide).slice(0, 3);

const products = (await getFeaturedProducts()).slice(0, 6);
const [lead, ...rest] = products;
const side = rest.slice(0, 2);
const grid = rest.slice(2);

const schema = [{ '@context': 'https://schema.org', '@type': 'WebSite', name: SITE_NAME, url: Astro.site?.href }];
---

<Base schema={schema}>
  <div class="wrap home">
    <section class="hero">
      <div class="copy">
        <p class="kicker">Gear picks and vet-sourced guides</p>
        <h1>
          Good stuff for <span class="squiggle">good dogs.<svg viewBox="0 0 320 16" aria-hidden="true" preserveAspectRatio="none"><path d="M4 10c38-9 62 5 104-1 44-6 73-5 112 0 36 5 62-5 96-2" /></svg></span>
          And cats, if they allow it.
        </h1>
        <p class="lede">
          Researched gear picks and safety guides checked against veterinary sources. Written for people who also get
          woken up at 5am for breakfast.
        </p>
        <div class="ctas">
          {lead && <a class="btn dark" href="#picks">See what we'd buy <Arrow size={19} /></a>}
          <a class="btn outline" href="#guides">Read the guides</a>
        </div>
      </div>
      <div class="polaroids" aria-hidden="true">
        <div class="polaroid one">
          <div class="photo pine"><Dog size={224} /></div>
          <div class="caption hand">chief treat tester</div>
        </div>
        <div class="polaroid two">
          <div class="photo tomato"><Cat size={186} /></div>
          <div class="caption hand">head of knocking things off shelves</div>
        </div>
        <div class="tape t1"></div>
        <div class="tape t2"></div>
      </div>
    </section>

    <section class="pets" aria-label="Browse by pet">
      <a class="pet plain dogs" href="/dogs/">
        <span class="name">Dogs</span>
        <span class="blurb">{PETS.dogs.blurb}</span>
        <span class="go">Everything for dogs <Arrow /></span>
        <Dog size={250} class="art" />
      </a>
      <a class="pet plain cats" href="/cats/">
        <span class="name">Cats</span>
        <span class="blurb">{PETS.cats.blurb}</span>
        <span class="go">Everything for cats <Arrow /></span>
        <Cat size={250} class="art" />
      </a>
    </section>

    {lead && (
      <section id="picks" class="block" aria-labelledby="picks-title">
        <div class="head">
          <div>
            <h2 id="picks-title">What we'd buy right now</h2>
            <p class="muted">We may earn a commission if you buy. It never decides what we pick.</p>
          </div>
        </div>
        <div class="picks-top">
          <div class="lead"><ProductPick id={lead.id} showRoundupLink /></div>
          {side.length > 0 && <div class="side">{side.map((p) => <ProductMini product={p} />)}</div>}
        </div>
        {grid.length > 0 && <div class="picks-grid">{grid.map((p) => <ProductMini product={p} />)}</div>}
      </section>
    )}

    <section id="guides" class="block" aria-labelledby="guides-title">
      <div class="head">
        <h2 id="guides-title">Quick, straight answers</h2>
      </div>
      <div class="guides">
        {featuredGuide && (
          <article class="answer">
            <p class="eyebrow muted">{PETS[featuredGuide.data.pet].label} · Guide</p>
            <h3><a class="plain" href={`/${featuredGuide.id}/`}>{featuredGuide.data.title}</a></h3>
            <div class="verdict">
              <span class="big">{featuredGuide.data.quickAnswer}</span>
              {featuredGuide.data.quickNote && <span class="hand aside">{featuredGuide.data.quickNote}</span>}
            </div>
            <p>{featuredGuide.data.description}</p>
            <a class="more" href={`/${featuredGuide.id}/`}>Read the guide <Arrow /></a>
          </article>
        )}
        <div class="rest"><GuideList articles={otherGuides} /></div>
      </div>
    </section>

    <section class="hello" aria-labelledby="hello-title">
      <div class="avatar">
        {OWNER_PHOTO ? <img src={OWNER_PHOTO} alt={OWNER_NAME ? `${OWNER_NAME} and their pet` : ''} /> : <Paw size={64} class="paw" />}
      </div>
      <div class="msg">
        <h2 id="hello-title">Hi. We started over.</h2>
        <p>
          We rebuilt {SITE_NAME} from the ground up, and the old pages are gone. Every guide now lists its sources and
          the date we last checked it. Every affiliate link is labeled. What we earn never decides what we pick.
        </p>
        <div class="sign">
          {OWNER_NAME && <span class="hand name">{OWNER_NAME}</span>}
          <a href="/how-we-research/">How we research <Arrow /></a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .home { display: flex; flex-direction: column; gap: 24px; }

  /* Hero */
  .hero { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 56px; padding: 68px 64px 72px; border-radius: 28px; background: var(--yellow); color: var(--fixed-ink); }
  .copy { flex: 1.3 1 480px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .kicker { margin: 0; font-size: 14px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; line-height: 1.3; }
  .hero h1 { margin: 0; font-size: clamp(2.7rem, 6.4vw, 74px); line-height: 1; }
  .squiggle { position: relative; display: inline-block; white-space: nowrap; }
  .squiggle svg { position: absolute; left: 0; bottom: -12px; width: 100%; height: 16px; fill: none; stroke: var(--tomato); stroke-width: 6; stroke-linecap: round; }
  .lede { margin: 8px 0 0; max-width: 500px; font-size: 20px; line-height: 1.5; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 6px; }
  .ctas .btn { min-height: 58px; padding: 0 28px; border-radius: 14px; font-size: 17.5px; }
  .btn.dark { background: var(--fixed-ink); color: #fff; }
  .btn.outline { background: transparent; border: 2px solid var(--fixed-ink); color: var(--fixed-ink); }

  .polaroids { flex: 1 1 400px; position: relative; max-width: 460px; height: 530px; margin: 0 auto; }
  .polaroid { position: absolute; background: #fff; box-shadow: 0 14px 28px rgba(28, 26, 23, 0.2); }
  .polaroid.one { right: 0; top: 0; width: 266px; padding: 12px 12px 10px; transform: rotate(4deg); }
  .polaroid.two { left: 0; bottom: 0; width: 214px; padding: 11px 11px 10px; transform: rotate(-6deg); }
  .photo { display: flex; align-items: flex-end; justify-content: center; overflow: hidden; }
  .one .photo { height: 236px; }
  .one .photo :global(svg) { margin-bottom: -18px; }
  .two .photo { height: 178px; }
  .two .photo :global(svg) { margin-bottom: -20px; }
  .pine { background: var(--pine); }
  .tomato { background: var(--tomato); }
  .caption { padding: 8px 4px 0; font-size: 27px; line-height: 1.1; color: var(--fixed-ink); text-align: center; }
  .two .caption { font-size: 22px; line-height: 1.05; }
  .tape { position: absolute; background: rgba(255, 255, 255, 0.6); }
  .t1 { right: 92px; top: -12px; width: 84px; height: 26px; transform: rotate(-3deg); }
  .t2 { left: 66px; bottom: 246px; width: 76px; height: 24px; transform: rotate(-11deg); }

  /* Pet tiles */
  .pets { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(420px, 100%), 1fr)); gap: 24px; }
  .pet { position: relative; overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; min-height: 250px; padding: 38px 40px; border-radius: 24px; }
  .pet:hover { text-decoration: none; }
  .dogs, .dogs:hover { background: var(--pine); color: #fff; }
  .cats, .cats:hover { background: var(--tomato); color: var(--fixed-ink); }
  .name { font-family: var(--display); font-weight: 800; font-size: 60px; line-height: 1; letter-spacing: -0.015em; }
  .blurb { max-width: 300px; font-size: 18px; line-height: 1.45; position: relative; z-index: 1; }
  .go { display: inline-flex; align-items: center; gap: 10px; margin-top: auto; font-size: 17px; font-weight: 700; text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 5px; position: relative; z-index: 1; }
  .pet :global(.art) { position: absolute; right: 18px; bottom: -48px; transition: transform 0.2s; }
  .pet:hover :global(.art) { transform: translateY(-8px) rotate(-3deg); }

  /* Sections */
  .block { display: flex; flex-direction: column; gap: 28px; margin-top: 60px; scroll-margin-top: 16px; }
  .head h2 { margin: 0 0 8px; font-size: clamp(2rem, 4.6vw, 46px); line-height: 1.04; letter-spacing: -0.02em; }
  .head p { margin: 0; font-size: 16px; }

  .picks-top { display: flex; flex-wrap: wrap; gap: 24px; }
  .lead { flex: 1.45 1 560px; min-width: 0; display: flex; }
  .lead :global(.pick) { margin: 0; flex: 1; }
  .side { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .picks-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 24px; }

  .guides { display: flex; flex-wrap: wrap; gap: 24px 48px; }
  .answer { flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 12px; padding: 40px 44px; border-radius: 24px; background: var(--sand); }
  .answer .eyebrow { margin: 0; }
  .answer h3 { margin: 0; font-size: clamp(1.6rem, 3.4vw, 34px); line-height: 1.1; }
  .answer h3 a { color: var(--ink); }
  .verdict { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 20px; margin-top: 4px; }
  .big { font-family: var(--display); font-weight: 800; font-size: clamp(72px, 12vw, 104px); line-height: 0.9; letter-spacing: -0.03em; color: var(--tomato-ink); }
  .aside { font-size: 28px; line-height: 1; transform: rotate(-3deg); }
  .answer p { margin: 6px 0 0; max-width: 440px; font-size: 17px; line-height: 1.55; }
  .more, .sign a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 16.5px; font-weight: 700; }
  .more { margin-top: auto; }
  .rest { flex: 1.2 1 480px; min-width: 0; }

  .hello { display: flex; flex-wrap: wrap; align-items: center; gap: 28px 48px; margin-top: 60px; padding: 44px 48px; border-radius: 24px; border: 1.5px solid var(--ink); }
  .avatar { flex-shrink: 0; display: flex; align-items: center; justify-content: center; width: 148px; height: 148px; border-radius: 50%; overflow: hidden; background: var(--sand); }
  .avatar img { width: 100%; height: 100%; object-fit: cover; }
  .avatar :global(.paw) { fill: var(--tomato); }
  .msg { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 10px; }
  .msg h2 { margin: 0; font-size: 34px; line-height: 1.08; }
  .msg p { margin: 0; max-width: 720px; font-size: 17.5px; line-height: 1.6; }
  .sign { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 28px; margin-top: 4px; }
  .sign .name { font-size: 34px; line-height: 1; }

  @media (max-width: 900px) {
    .hero { padding: 44px 32px 48px; }
    .polaroids { display: none; }
  }
  @media (max-width: 600px) {
    .hero { padding: 36px 22px 40px; border-radius: 22px; }
    .lede { font-size: 18px; }
    .ctas, .ctas .btn { width: 100%; }
    .pet { min-height: 220px; padding: 28px 26px; }
    .name { font-size: 48px; }
    .pet :global(.art) { width: 140px; right: 0; bottom: -34px; }
    .blurb { max-width: 60%; }
    .answer, .hello { padding: 28px 24px; }
    .avatar { width: 96px; height: 96px; }
  }
</style>
